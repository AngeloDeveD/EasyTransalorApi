APP_PORT=8080
DB_TYPE=sqlite
DB_NAME=app.db
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=secret
JWT_SECRET=super_secret_dev_key_123
ENCRYPT_KEY=12345678901234567890123456789012
INTERNAL_KEY=super_secret_cloud_key_998

# Куда Go шлёт POST /scan после загрузки архива.
# Локально (Go запущен на хосте): http://localhost:8000/scan
# В docker-compose (сервис api): http://scanner:8000/scan
SCANNER_URL=http://localhost:8000/scan

# Корень, по которому загрузки видны контейнеру-сканеру.
# Общий том ./uploads примонтирован и в api, и в scanner как /app/uploads.
SCANNER_FILE_ROOT=/app/uploads

# Доверенные browser origins для CORS, через запятую. Не используйте * для JWT-запросов.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_GLOBAL_REQUESTS=120
RATE_LIMIT_GLOBAL_WINDOW=1m
RATE_LIMIT_AUTH_REQUESTS=10
RATE_LIMIT_AUTH_WINDOW=1m
RATE_LIMIT_WRITE_REQUESTS=1
RATE_LIMIT_WRITE_WINDOW=10s
