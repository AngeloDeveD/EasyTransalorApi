# === ClamAV ===
# В docker-compose сканер ходит в ClamAV по TCP (сервис clamav:3310).
CLAMD_HOST=clamav
CLAMD_PORT=3310
# Локальный запуск с юникс-сокетом clamd (если CLAMD_HOST пуст):
CLAMD_SOCKET=/var/run/clamav/clamd.ctl

# === YARA ===
YARA_RULES_DIR=/etc/yara/rules

# === Песочница (динамический анализ) ===
# По умолчанию ВЫКЛЮЧЕНА: статической проверки (ClamAV + YARA) достаточно,
# а песочнице нужна отдельная инфраструктура (VM/CAPE), которой пока нет.
# Включать только когда появится готовый sandbox-эндпоинт.
SANDBOX_ENABLED=false
SANDBOX_API=
SANDBOX_TOKEN=

# === Пути ===
EXTRACT_ROOT=/tmp/av_extract
QUARANTINE_ROOT=/var/quarantine

# === Обратный вызов в основной API ===
# Сюда сканер шлёт вердикт (POST). В docker-compose это сервис api.
MAIN_API_URL=http://api:8080/api/internal/scan-result
# Общий секрет для заголовка X-Internal-Key (должен совпадать с InternalKey в Go).
InternalKey=super_secret_cloud_key_998
